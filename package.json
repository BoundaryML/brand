    "./logo/*": "./logo/*"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tz build",
    "check": "tz build && test -z \"$(git status --porcelain --untracked-files=all -- dist)\""
  },
  "devDependencies": {
    "@terrazzo/cli": "2.9.0",
    "@terrazzo/plugin-css": "2.9.0",
    "@terrazzo/token-tools": "2.9.0"
  }
