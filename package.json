{
  "name": "@boundaryml/brand",
  "version": "1.0.0",
  "description": "Boundary and BAML brand tokens, logos and favicons",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:BoundaryML/brand",
  "files": [
    "agents.md",
    "design.md",
    "tokens.json",
    "dist",
    "logo"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
